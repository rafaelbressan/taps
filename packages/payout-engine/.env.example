# The payout engine refuses to start without every variable below. None has a
# default: a missing signer endpoint that falls back to something else, or a
# ceiling nobody set, is worse than a process that will not boot.

# --- Signing -----------------------------------------------------------------
# The key that holds the funds lives on the octez-signer host and never here.
# Only `unix://` and `https://` are accepted; cleartext HTTP is refused.
#
# The signer is expected to be started with, explicitly:
#   --magic-bytes 0x03          only generic operations
#   --require-authentication    plus `octez-signer add authorized key <pk>`
# and WITHOUT --allow-list-known-keys, --allow-to-prove-possession or
# --password-filename. Unlocking is interactive at daemon start: one human
# action per restart, never one per payout cycle.
TAPS_SIGNER_URL=unix:///run/taps/signer.sock
TAPS_SIGNER_PKH=
# The CLIENT credential. It proves who is asking; it is not the payout key and
# moves no money on its own.
TAPS_SIGNER_CLIENT_AUTH_KEY=

# --- Ceiling -----------------------------------------------------------------
# The most one cycle may move, in mutez. Above it the run stops and a human
# approves it, or it does not happen.
TAPS_PAYOUT_CYCLE_CAP_MUTEZ=

# --- Network -----------------------------------------------------------------
# Read by @tezos-suite/chain. Endpoints are configuration, never code; there is
# no built-in network list, and no protocol constant is named anywhere.
TEZOS_NETWORK=
TEZOS_RPC_URL=
TZKT_API_URL=
