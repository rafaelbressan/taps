# The payout engine refuses to start without every variable below. None has a
# default: a missing signer endpoint that falls back to something else, or a
# ceiling nobody set, is worse than a process that will not boot.

# --- Signing -----------------------------------------------------------------
# The key that holds the funds lives on the octez-signer host and never here.
#
# TLS only. Verified against octez-signer 25.1: this JSON API is served by
# `launch http signer` and `launch https signer`, both TCP; `launch local
# signer` and `launch socket signer` speak a different, binary protocol. There
# is no mode that serves it over a unix socket, so `unix://` is refused.
#
# Start the signer with, explicitly:
#   launch https signer <cert> <key>
#   --magic-bytes 0x03          only generic operations
# and WITHOUT --allow-list-known-keys, --allow-to-prove-possession or
# --password-filename. Unlocking is interactive at daemon start: one human
# action per restart, never one per payout cycle.
TAPS_SIGNER_URL=https://signer.internal:6732
TAPS_SIGNER_PKH=

# Point Node at the signer's certificate when it is self-signed.
NODE_EXTRA_CA_CERTS=/etc/taps/signer-tls.crt

# The CLIENT credential, for a signer started with --require-authentication.
# LEAVE IT EMPTY: this client cannot satisfy that check yet — the signer
# answers `invalid authentication signature` to every payload it builds. See
# src/chain/client-auth.ts. Closing this is a prerequisite for mainnet.
TAPS_SIGNER_CLIENT_AUTH_KEY=

# --- Ceiling -----------------------------------------------------------------
# The most one cycle may move, in mutez. Above it the run stops and a human
# approves it, or it does not happen.
TAPS_PAYOUT_CYCLE_CAP_MUTEZ=

# --- Network -----------------------------------------------------------------
# Read by @tezos-suite/chain. Endpoints are configuration, never code; there is
# no built-in network list, and no protocol constant is named anywhere.
TEZOS_NETWORK=
TEZOS_RPC_URL=
TZKT_API_URL=
