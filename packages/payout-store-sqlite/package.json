{
  "name": "@tezos-suite/payout-store-sqlite",
  "version": "0.1.0",
  "description": "PayoutStore em SQLite, com migrations versionadas, backup verificável e importação do banco da versão antiga. É o armazenamento do TAPS local-first.",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-sqlite --no-warnings node_modules/.bin/jest --config jest.config.js",
    "check:money": "node ../payout-engine/scripts/check-no-number-money.mjs src",
    "verify": "npm run check:money && npm run typecheck && npm test"
  },
  "dependencies": {
    "@tezos-suite/chain": "file:../tezos-chain",
    "@tezos-suite/payout": "file:../payout-engine"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  }
}
