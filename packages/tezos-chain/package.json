{
  "name": "@tezos-suite/chain",
  "version": "0.1.0",
  "description": "Camada de cadeia da Suíte Tezos — constantes lidas da rede, cliente TzKT correto, Adaptive Issuance e batch/confirmação. Compartilhada por Tezzet e TAPS.",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:contract": "jest --config jest.contract.config.js --runInBand",
    "check:constants": "node scripts/check-no-protocol-constants.mjs",
    "verify": "npm run check:constants && npm run typecheck && npm test"
  },
  "dependencies": {
    "@taquito/taquito": "25.0.0",
    "@taquito/utils": "25.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": { "node": ">=20" }
}
