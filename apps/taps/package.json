{
  "name": "@tezosrio/taps-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TAPS — aplicativo desktop local-first para distribuição de recompensas de baker Tezos.",
  "scripts": {
    "suite:fetch": "node scripts/fetch-suite.mjs",
    "predev": "npm run suite:fetch",
    "dev": "vite",
    "prebuild": "npm run suite:fetch",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run suite:fetch",
    "typecheck": "tsc -b --force",
    "check:design": "node scripts/check-design-tokens.mjs",
    "pretest": "npm run suite:fetch",
    "test": "vitest run",
    "verify": "npm run suite:fetch && npm run check:design && npm run typecheck && npm run test && npm run build && npm run check:bundle",
    "tauri": "tauri",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@taquito/taquito": "^25.0.0",
    "@taquito/utils": "^25.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "buffer": "^6.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "blakejs": "^1.2.1",
    "@stablelib/ed25519": "^1.0.3",
    "@taquito/local-forging": "25.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
